{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullPolicy",
    "rootExistingSecret",
    "existingClaim",
    "runAsUser",
    "runAsGroup",
    "fsGroup",
    "size",
    "resources",
    "storageClass",
    "region",
    "nodeSelector",
    "tolerations",
    "imagePullSecrets"
  ],
  "properties": {
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullPolicy": {
      "$ref": "#/definitions/pullPolicy"
    },
    "rootExistingSecret": {
      "$ref": "#/definitions/optionalName"
    },
    "mode": {
      "enum": ["standalone", "distributed"]
    },
    "distributed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "drivesPerNode", "driveSize"],
      "properties": {
        "replicas": {"const": 3},
        "drivesPerNode": {"const": 1},
        "driveSize": {"$ref": "#/definitions/size"}
      }
    },
    "existingClaim": {
      "$ref": "#/definitions/optionalName"
    },
    "runAsUser": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "runAsGroup": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "fsGroup": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "size": {
      "$ref": "#/definitions/size"
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "storageClass": {
      "$ref": "#/definitions/name"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]{1,64}$"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/toleration"
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/name"
          }
        }
      }
    },
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "definitions": {
    "toleration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "operator": {
          "enum": [
            "Equal",
            "Exists"
          ]
        },
        "value": {
          "type": "string"
        },
        "effect": {
          "enum": [
            "",
            "NoSchedule",
            "PreferNoSchedule",
            "NoExecute"
          ]
        },
        "tolerationSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "operator"
            ],
            "properties": {
              "operator": {
                "const": "Exists"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "key"
              ],
              "properties": {
                "key": {
                  "minLength": 1
                }
              }
            }
          },
          "then": {
            "required": [
              "operator"
            ],
            "properties": {
              "operator": {
                "const": "Exists"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tolerationSeconds"
            ]
          },
          "then": {
            "required": [
              "effect"
            ],
            "properties": {
              "effect": {
                "const": "NoExecute"
              }
            }
          }
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "optionalName": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$"
    },
    "size": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
    },
    "image": {
      "type": "string",
      "pattern": "^[^\\s]+(:[^/\\s]+|@sha256:[a-f0-9]{64})$",
      "not": {
        "pattern": ":latest$"
      }
    },
    "pullPolicy": {
      "enum": [
        "IfNotPresent",
        "Always"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^([1-9][0-9]*m?|0\\.[0-9]*[1-9][0-9]*)$"
        },
        "memory": {
          "$ref": "#/definitions/size"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resource"
        },
        "limits": {
          "$ref": "#/definitions/resource"
        }
      }
    }
  }
}
