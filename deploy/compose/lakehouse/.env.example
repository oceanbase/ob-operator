# Optional: copy to .env only if the release does not already include .env.
# Keep a delivered .env and its exact release image tags/build references.
# Optional common registry/namespace; no https:// prefix or trailing slash.
# Example: registry.example.com:5000/team/lakehouse
# Shell/exported IMAGE_REGISTRY takes precedence over this empty default.
IMAGE_REGISTRY=

COMPOSE_PROJECT_NAME=ob-lakehouse
# Optional override for multi-NIC or NAT hosts. Empty auto-detects the default-route source IP.
HOST_ACCESS_IP=
HOST_BIND_ADDRESS=0.0.0.0
OBSERVER_SQL_BIND_ADDRESS=0.0.0.0
OBSHELL_BIND_ADDRESS=0.0.0.0
OBSERVER_SQL_HOST_PORT=32881
OBSHELL_HOST_PORT=32886
PROMETHEUS_HOST_PORT=39090
ALERTMANAGER_HOST_PORT=39093
AUTO_REGISTER_MONITORING=true
PROMETHEUS_INTERNAL_URL=http://prometheus:9090/
ALERTMANAGER_INTERNAL_URL=http://alertmanager:9093
MONITORING_REGISTER_TIMEOUT_SECONDS=600

# All eight base images must exist in the selected repository with these exact tags.
# A full *_IMAGE reference overrides IMAGE_REGISTRY; digest references work too.
# Keep the interpolation below to allow exported/inline IMAGE_REGISTRY overrides.
OBSERVER_IMAGE=${IMAGE_REGISTRY:-oceanbase}/oceanbase-ai-cloud-native:4.6.3.0-82026110121.al8-r3
LOGSERVICE_IMAGE=${IMAGE_REGISTRY:-oceanbase}/oblogservice:1.3.3-42026110118.al8-r1
BOOTSTRAP_IMAGE=${IMAGE_REGISTRY:-oceanbase}/lakehouse-bootstrap:20261103-monitoring-r1
MINIO_IMAGE=${IMAGE_REGISTRY:-minio}/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=${IMAGE_REGISTRY:-minio}/mc:RELEASE.2025-08-13T08-35-41Z
OBAGENT_IMAGE=${IMAGE_REGISTRY:-oceanbase}/obagent:4.2.4-200000022025090416
PROMETHEUS_IMAGE=${IMAGE_REGISTRY:-quay.io/prometheus}/prometheus:v2.51.1
ALERTMANAGER_IMAGE=${IMAGE_REGISTRY:-quay.io/prometheus}/alertmanager:v0.27.0

OBSERVER_CPUS=2
OBSERVER_CPU_COUNT=2
OBSERVER_MEMORY_LIMIT=10G
OBSERVER_CONTAINER_MEMORY=12g
OBSERVER_DATAFILE_SIZE=10G
LOGSERVICE_CPUS=1
LOGSERVICE_MEMORY_LIMIT=3G
LOGSERVICE_CONTAINER_MEMORY=4g
LOGSERVICE_LOG_DISK_SIZE=10G
MINIO_MEMORY=1g
OBAGENT_CPUS=0.5
OBAGENT_MEMORY=512m
BOOTSTRAP_TIMEOUT=30m

# Persisted cluster addresses. Change all of these together BEFORE first start.
COMPOSE_SUBNET=172.30.52.0/24
MINIO_IP=172.30.52.10
LOGSERVICE_IP_1=172.30.52.11
LOGSERVICE_IP_2=172.30.52.12
LOGSERVICE_IP_3=172.30.52.13
OBSERVER_IP=172.30.52.21

# Used only with compose.monitoring.yaml; monitoring is private by default.
MONITORING_BIND_ADDRESS=127.0.0.1
