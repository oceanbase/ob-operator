# Optional: copy to .env only if the release does not already include .env.
# Keep a delivered .env and its exact release image tags/build references.
# Optional common registry/namespace; no https:// prefix or trailing slash.
# Example: registry.example.com:5000/team/lakehouse
# Shell/exported IMAGE_REGISTRY takes precedence over this empty default.
IMAGE_REGISTRY=

COMPOSE_PROJECT_NAME=ob-lakehouse
HOST_BIND_ADDRESS=127.0.0.1
OBSERVER_SQL_HOST_PORT=32881

# All five images must exist in the selected repository with these exact tags.
# A full *_IMAGE reference overrides IMAGE_REGISTRY; digest references work too.
# Keep the interpolation below to allow exported/inline IMAGE_REGISTRY overrides.
OBSERVER_IMAGE=${IMAGE_REGISTRY:-oceanbase}/oceanbase-ai-cloud-native:4.6.2.1-100000092026090921.al8
LOGSERVICE_IMAGE=${IMAGE_REGISTRY:+${IMAGE_REGISTRY}/}oblogservice:1.3.0
BOOTSTRAP_IMAGE=${IMAGE_REGISTRY:-ghcr.io/oceanbase}/lakehouse-bootstrap:0.1.0
MINIO_IMAGE=${IMAGE_REGISTRY:-minio}/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=${IMAGE_REGISTRY:-minio}/mc:RELEASE.2025-08-13T08-35-41Z

OBSERVER_CPUS=2
OBSERVER_CPU_COUNT=2
OBSERVER_MEMORY_LIMIT=10G
OBSERVER_CONTAINER_MEMORY=12g
OBSERVER_DATAFILE_SIZE=10G
LOGSERVICE_CPUS=1
LOGSERVICE_MEMORY_LIMIT=3G
LOGSERVICE_CONTAINER_MEMORY=4g
LOGSERVICE_LOG_DISK_SIZE=10G
MINIO_MEMORY=1g
BOOTSTRAP_TIMEOUT=30m

# Persisted cluster addresses. Change all of these together BEFORE first start.
COMPOSE_SUBNET=172.30.52.0/24
MINIO_IP=172.30.52.10
LOGSERVICE_IP_1=172.30.52.11
LOGSERVICE_IP_2=172.30.52.12
LOGSERVICE_IP_3=172.30.52.13
OBSERVER_IP=172.30.52.21
