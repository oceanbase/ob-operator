OBSERVER_IMAGE=oceanbase/oceanbase-ai-cloud-native:4.6.2.1-100000092026090921.al8
LOGSERVICE_IMAGE=oblogservice:1.3.0
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
BOOTSTRAP_IMAGE=ob-operator/lakehouse-bootstrap:local
# Set to 0 to use a prebuilt BOOTSTRAP_IMAGE without a local Go/Docker build.
BUILD_BOOTSTRAP=1
COMPOSE_PROJECT_NAME=ob-lakehouse
HOST_BIND_ADDRESS=127.0.0.1
BOOTSTRAP_TIMEOUT=30m
STARTUP_TIMEOUT_SECONDS=2400
# Explicit opt-in when migrating an already-bootstrapped empty-password database.
ALLOW_LEGACY_EMPTY_ROOT=false

CLUSTER_NAME=lakehouse-compose
OBSERVER_CLUSTER_ID=10001
LOGSERVICE_CLUSTER_ID=10002
ZONE_NAME=zone1
REGION_NAME=region1

MINIO_IP=172.30.52.10
LOGSERVICE_IP_1=172.30.52.11
LOGSERVICE_IP_2=172.30.52.12
LOGSERVICE_IP_3=172.30.52.13
OBSERVER_IP=172.30.52.21
COMPOSE_SUBNET=172.30.52.0/24

OBSERVER_CPU_COUNT=16
OBSERVER_DATAFILE_SIZE=10G
OBSERVER_MEMORY_LIMIT=8G
LOGSERVICE_LOG_DISK_SIZE=10G

OBSERVER_SQL_HOST_PORT=32881
OBSERVER_RPC_HOST_PORT=32882
LOGSERVICE_RPC_HOST_PORT=15051
LOGSERVICE_HTTP_HOST_PORT=15052
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

LOGSERVICE_BUCKET=lakehouse-logservice
SHARED_STORAGE_BUCKET=lakehouse-data
S3_REGION=us-east-1
