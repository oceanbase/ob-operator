+// lakehouseReady gates admission for a new MinIO process. Once admitted, the
+// normal write-quorum check above keeps surviving members available.
+func (z *erasureServerPools) lakehouseReady(ctx context.Context) bool {
+	if z.lakehouseAdmitted.Load() {
+		return true
+	}
+	if len(z.serverPools) != 1 || len(z.serverPools[0].sets) != 1 {
+		return false
+	}
+	disks := z.serverPools[0].sets[0].getDisks()
+	if len(disks) != 3 {
+		return false
+	}
+	ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	for _, disk := range disks {
+		if disk == nil || !disk.IsOnline() {
+			return false
+		}
+		// Bypass cached health and verify the disk ID over the metadata RPC.
+		if _, err := disk.DiskInfo(ctx, DiskInfoOptions{NoOp: true}); err != nil {
+			return false
+		}
+		if peer, ok := disk.(*storageRESTClient); ok {
+			// Inline reads and object data use the authenticated REST client.
+			body, err := peer.call(ctx, storageRESTMethodHealth, nil, nil, -1)
+			if err != nil {
+				return false
+			}
+			xhttp.DrainBody(body)
+		}
+	}
+	z.lakehouseAdmitted.Store(true)
+	return true
+}
