@@ -0,0 +1,96 @@
+package cmd
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+type rejoinTestDisk struct {
+	StorageAPI
+	raw     RawFileInfo
+	readErr error
+	infoErr error
+}
+
+func (*rejoinTestDisk) IsOnline() bool { return true }
+
+func (disk *rejoinTestDisk) ReadXL(context.Context, string, string, bool) (RawFileInfo, error) {
+	return disk.raw, disk.readErr
+}
+
+func (disk *rejoinTestDisk) DiskInfo(_ context.Context, opts DiskInfoOptions) (DiskInfo, error) {
+	if !opts.NoOp {
+		panic("readiness used cached disk information")
+	}
+	return DiskInfo{}, disk.infoErr
+}
+
+func TestLakehouseRejoinObjectQuorum(t *testing.T) {
+	const bucket, object = "rejoin-bucket", "written-during-outage"
+	fi := newFileInfo(object, 2, 1)
+	fi.Volume = bucket
+	fi.ModTime = time.Unix(1700000000, 0).UTC()
+	fi.DataDir = mustGetUUID()
+	fi.Erasure.Index = 1
+	var xl xlMetaV2
+	if err := xl.AddVersion(fi); err != nil {
+		t.Fatal(err)
+	}
+	buf, err := xl.AppendTo(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	present := &rejoinTestDisk{raw: RawFileInfo{Buf: buf}}
+	missing := &rejoinTestDisk{readErr: errFileNotFound}
+	for _, tt := range []struct {
+		name   string
+		disks  []StorageAPI
+		status int
+	}{
+		{"outage write with peer not yet connected", []StorageAPI{missing, present, nil}, 503},
+		{"genuine absence with peer offline", []StorageAPI{missing, missing, nil}, 404},
+		{"existing object with peer offline", []StorageAPI{present, present, nil}, 200},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			er := erasureObjects{setDriveCount: 3, defaultParityCount: 1, getDisks: func() []StorageAPI { return tt.disks }}
+			_, _, _, err := er.getObjectFileInfo(ctx, bucket, object, ObjectOptions{}, false)
+			status := 200
+			if err != nil {
+				status = toAPIError(ctx, err).HTTPStatusCode
+			}
+			if status != tt.status {
+				t.Fatalf("expected HTTP %d, got %d (%v)", tt.status, status, err)
+			}
+		})
+	}
+}
+
+func TestLakehouseRejoinAdmission(t *testing.T) {
+	ctx := context.Background()
+	disks := []StorageAPI{&rejoinTestDisk{}, &rejoinTestDisk{}, nil}
+	newProcess := func() *erasureServerPools {
+		set := &erasureObjects{getDisks: func() []StorageAPI { return disks }}
+		return &erasureServerPools{serverPools: []*erasureSets{{sets: []*erasureObjects{set}}}}
+	}
+	running := newProcess()
+	if running.lakehouseReady(ctx) {
+		t.Fatal("new process admitted with an absent peer")
+	}
+	disks[2] = &rejoinTestDisk{infoErr: errDiskNotFound}
+	if running.lakehouseReady(ctx) {
+		t.Fatal("new process admitted with a stale peer")
+	}
+	disks[2] = &rejoinTestDisk{}
+	if !running.lakehouseReady(ctx) {
+		t.Fatal("process with three current disks did not admit")
+	}
+	disks[2] = nil
+	if !running.lakehouseReady(ctx) {
+		t.Fatal("admitted process lost admission during a single peer outage")
+	}
+	if newProcess().lakehouseReady(ctx) {
+		t.Fatal("admission survived a process restart")
+	}
+}
